# Telegram Bot Token (@BotFather dan oling)
BOT_TOKEN=your_bot_token_here

# Admin Telegram User ID (statistika uchun)
ADMIN_ID=your_telegram_user_id

# Maksimal fayl hajmi MB da (Telegram limiti: 50 MB bepul, 2000 MB premium)
MAX_FILE_SIZE_MB=50

# Vaqtinchalik fayllar papkasi
DOWNLOAD_DIR=downloads

# Rate limiting: bir foydalanuvchi uchun minutiga maksimal so'rovlar
RATE_LIMIT=5
